# Uncomment MONGO_URL only if you run a separate MongoDB on 27017.
# Leaving it commented keeps Meteor on its bundled DB (port 3001), where your
# current data (users, jobs, etc.) lives. Enabling it points the app at an
# empty `hhs` database and will fail if nothing is listening on 27017.
# MONGO_URL=mongodb://localhost:27017/hhs

CONTACT_EMAIL=

# SMTP connection string for outbound email. Generic format:
#   smtps://USERNAME:PASSWORD@SMTP_HOST:PORT   (smtps = implicit TLS, usually port 465)
#   smtp://USERNAME:PASSWORD@SMTP_HOST:PORT    (smtp  = STARTTLS,      usually port 587)
#
# URL-encode any special characters in USERNAME/PASSWORD (e.g. "@" -> "%40").
#
# Examples (pick your provider):
#   Gmail:    smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
#   SendGrid: smtps://apikey:SG.your-api-key@smtp.sendgrid.net:465
#   Mailgun:  smtps://postmaster%40mg.example.com:PASSWORD@smtp.mailgun.org:465
#   Outlook:  smtp://you%40outlook.com:PASSWORD@smtp.office365.com:587
MAIL_URL="smtps://<USERNAME>:<PASSWORD>@<SMTP_HOST>:<PORT>"